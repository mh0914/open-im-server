# Target server and public access
SERVER_LAN_IP=192.168.1.16
PUBLIC_HOST=59.46.214.114
PUBLIC_HTTP_PORT=18080
PUBLIC_HTTPS_PORT=9443

# Install behavior
INSTALL_DOCKER=1
INSTALL_NGINX=1
ENABLE_TLS=0

# If ENABLE_TLS=1, replace these with real certificate paths on the server.
SSL_CERT_FILE=/etc/nginx/ssl/openim/fullchain.pem
SSL_KEY_FILE=/etc/nginx/ssl/openim/privkey.pem

# Runtime layout
BASE_DIR=/mnt/im
RUNTIME_DIR=/mnt/im/runtime

# Image tags
OPENIM_SERVER_IMAGE=local/openim-server:kylin-20260411
OPENIM_CHAT_IMAGE=local/openim-chat:kylin-20260411
MONGO_IMAGE=docker.m.daocloud.io/library/mongo:7.0
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.0.0
ETCD_IMAGE=docker.m.daocloud.io/bitnamilegacy/etcd:3.5.13
KAFKA_IMAGE=docker.m.daocloud.io/bitnamilegacy/kafka:3.5.1
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2024-01-11T07-46-16Z

# OpenIM runtime ports on the host. These are only bound to 127.0.0.1 and
# exposed to the Internet through host Nginx.
OPENIM_MSG_GATEWAY_PORT=10001
OPENIM_API_PORT=10002
OPENIM_CHAT_API_PORT=10008
OPENIM_CHAT_ADMIN_PORT=10009
MINIO_PORT=10005
MINIO_CONSOLE_PORT=10004

# Service credentials
TZ=Asia/Shanghai
OPENIM_SECRET=openIM123
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=openIM123
MONGO_DATABASE=openim_v3
MONGO_USERNAME=openIM
MONGO_PASSWORD=openIM123
REDIS_PASSWORD=openIM123
MINIO_ACCESS_KEY_ID=root
MINIO_SECRET_ACCESS_KEY=openIM123
ETCD_ROOT_USER=
ETCD_ROOT_PASSWORD=
ETCD_USERNAME=
ETCD_PASSWORD=

